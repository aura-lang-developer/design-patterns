// =============================================================================
// Patrón de Diseño: Strategy v2 (Enrutamiento de Órdenes Bursátiles y Pipelines)
// =============================================================================
// Propósito:
//   Define una familia de algoritmos intercambiables (Estrategias de Enrutamiento
//   Financiero), encapsula cada uno y los hace intercambiables en tiempo de ejecución.
//
// En Aura:
//   Se presentan dos formas complementarias:
//   1. Estrategia Polimórfica mediante Duck Typing Estructural (interfaz OrderRoutingStrategy).
//   2. Estrategia Funcional Pura mediante el Operador Pipeline (`|>`) y Transductores.
//
// Características de Aura Lang Destacadas:
//   - Operador Pipeline (`|>`) para encadenamiento fluido de transformaciones.
//   - Transductores (`compose`, `filtering`, `mapping`, `into`) para procesamiento sin arrays intermedios.
//   - Átomos internados (:dark_pool, :direct_exchange, :smart_order_router).
//   - Slices nativos estilo Go ([]Int, len, rebanado orders[1:4]).
//   - Duck Typing Estructural.
// =============================================================================

// 1. Interfaz Polimórfica de la Estrategia (Duck Typing)
export interface OrderRoutingStrategy {
  getStrategyName(): Atom;
  calculateExecutionFee(volume: Int, price: Float): Float;
  route(orderId: String, volume: Int): String;
}

// 2. Estrategia Concreta A: Dark Pool (Cero impacto de mercado, comisión fija)
export fn createDarkPoolStrategy(): OrderRoutingStrategy => {
  {
    getStrategyName: (): Atom => :dark_pool,
    calculateExecutionFee: (volume: Int, price: Float): Float => 15.0, // Tarifa fija plana
    route: (orderId: String, volume: Int): String =>
      `[DARK-POOL] Orden #${orderId} (${volume} acciones) ejecutada fuera de libro público.`
  }
};

// 3. Estrategia Concreta B: Direct Market Access (DMA / Direct Exchange)
export fn createDirectExchangeStrategy(exchangeMic: String): OrderRoutingStrategy => {
  {
    getStrategyName: (): Atom => :direct_exchange,
    calculateExecutionFee: (volume: Int, price: Float): Float => {
      let notional = (volume * 1.0) * price;
      notional * 0.0005 // 5 puntos básicos
    },
    route: (orderId: String, volume: Int): String =>
      `[DIRECT-EXCHANGE @ ${exchangeMic}] Orden #${orderId} (${volume} acciones) enviada directamente al libro L3.`
  }
};

// 4. Estrategia Concreta C: Smart Order Router (SOR) Algorítmico
export fn createSmartOrderRouterStrategy(): OrderRoutingStrategy => {
  {
    getStrategyName: (): Atom => :smart_order_router,
    calculateExecutionFee: (volume: Int, price: Float): Float => {
      let base = 5.0;
      let variable = (volume * 1.0) * 0.0002;
      base + variable
    },
    route: (orderId: String, volume: Int): String =>
      `[SOR-ALGO] Orden #${orderId} fragmentada dinámicamente entre NYSE, NASDAQ y BATS.`
  }
};

// 5. Contexto de Ejecución de Estrategias
export fn executeTrade(strategy: OrderRoutingStrategy, orderId: String, volume: Int, price: Float): Unit => {
  let fee = strategy.calculateExecutionFee(volume, price);
  let routeMsg = strategy.route(orderId, volume);
  println(`  📈 [Estrategia: ${strategy.getStrategyName()}] Tarifa estimada: $${fee}`);
  println(`     ${routeMsg}`);
};

// 6. Estrategia Funcional Pura mediante Funciones de Primera Clase y Pipeline (|>)
fn applyExchangeSurcharge(amount: Float): Float => amount + 1.25;
fn applyVolumeDiscount(amount: Float): Float => amount * 0.90; // 10% descuento por gran volumen
fn applyRegulatoryTax(amount: Float): Float => amount * 1.02;  // 2% impuesto bursátil

// 7. Demostración y Ejecución
export fn main(): Unit => {
  println("==================================================");
  println("  PATRÓN STRATEGY v2 EN AURA LANG");
  println("==================================================");

  println("1. Enfoque Polimórfico: Conmutación Dinámica de Estrategias:\n");

  let darkPool = createDarkPoolStrategy();
  let dmaNasdaq = createDirectExchangeStrategy("XNAS");
  let sor = createSmartOrderRouterStrategy();

  println("A. Orden Institucional Grande (10,000 acciones @ $150.0):");
  executeTrade(darkPool, "ORD-9901", 10000, 150.0);

  println("\nB. Orden de Alta Frecuencia DMA (500 acciones @ $280.0):");
  executeTrade(dmaNasdaq, "ORD-9902", 500, 280.0);

  println("\nC. Orden Retail Fragmentada con Smart Order Router (1,200 acciones @ $45.0):");
  executeTrade(sor, "ORD-9903", 1200, 45.0);

  println("\n--------------------------------------------------");
  println("2. Enfoque Funcional Puro con Operador Pipeline (|>):");

  let baseFee: Float = 20.0;
  let finalCalculatedFee = baseFee
    |> applyExchangeSurcharge
    |> applyVolumeDiscount
    |> applyRegulatoryTax;

  println(`  - Tarifa base: $${baseFee}`);
  println(`  - Tarifa tras pipeline (|>) [Surcharge -> Discount -> RegulatoryTax]: $${finalCalculatedFee}`);

  println("\n--------------------------------------------------");
  println("3. Estrategia de Selección de Lotes con Slices y Transductores:");

  let orderLots: []Int = [50, 500, 1200, 80, 2500, 300, 4000, 90];
  println(`  - Lotes originales: len = ${len(orderLots)}`);

  // Slicing de lotes intermedios
  let midLots = orderLots[1:5];
  println(`  - Rebanado orderLots[1:5]: [${midLots[0]}, ${midLots[1]}, ${midLots[2]}, ${midLots[3]}]`);

  // Transductor para seleccionar lotes institucionales (>= 500) y normalizar
  let institutionalLots: List<Int> = [50, 500, 1200, 80, 2500, 300, 4000, 90];
  let institutionalXform = compose(
    filtering(fn(lot: Int): Bool => lot >= 500),
    mapping(fn(lot: Int): Int => lot / 100), // En centenas de acciones
    taking(3)
  );

  let selectedLots = into([], institutionalXform, institutionalLots);
  println(`  - Top 3 lotes institucionales normalizados (en centenas): ${selectedLots}`);

  println("\n✓ Strategy v2 ejecutado exitosamente.");
};
